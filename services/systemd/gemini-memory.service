[Unit]
Description=Gemini OS — AI Memory Agent
After=gemini-orchestrator.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -c "import asyncio; from ai_agents.memory_agent import MemoryAgent; a = MemoryAgent(); asyncio.run(a.start())"
WorkingDirectory=/usr/lib/geminios
Restart=always
RestartSec=10
Environment=PYTHONPATH=/usr/lib/geminios

[Install]
WantedBy=multi-user.target
