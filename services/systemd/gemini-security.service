[Unit]
Description=Gemini OS — AI Security Agent
After=gemini-orchestrator.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -c "import asyncio; from ai_agents.security_agent import SecurityAgent; a = SecurityAgent(); asyncio.run(a.start())"
WorkingDirectory=/usr/lib/geminios
Restart=always
RestartSec=10
Environment=PYTHONPATH=/usr/lib/geminios

[Install]
WantedBy=multi-user.target
