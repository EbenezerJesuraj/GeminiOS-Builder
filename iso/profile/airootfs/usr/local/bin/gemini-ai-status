#!/bin/bash
# ============================================================
# Gemini AI Status — Waybar module
# Reports AI system status for the taskbar
# ============================================================

STATUS=$(curl -s http://127.0.0.1:8420/api/v1/status 2>/dev/null)

if [ -n "$STATUS" ]; then
    ORCH=$(echo "$STATUS" | python3 -c "import sys,json; print(json.load(sys.stdin).get('orchestrator','?'))" 2>/dev/null)
    if [ "$ORCH" = "operational" ]; then
        echo "Active"
    else
        echo "Init"
    fi
else
    echo "Off"
fi
